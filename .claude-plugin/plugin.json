  "keywords": ["core", "permissions", "hooks", "MCP", "playbooks", "git", "pull-requests", "code-review"],
  "hooks": ["./hooks/hooks.d/comm.json", "./hooks/hooks.d/tasks.json", "./hooks/hooks.d/coding.json"],
  "mcpServers": {
    "cli": {
      "command": "${CLAUDE_PLUGIN_ROOT}/servers/cli_server.py",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    "db": {
      "command": "${CLAUDE_PLUGIN_ROOT}/servers/db_server.py",
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  }
