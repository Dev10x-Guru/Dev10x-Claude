{
  "description": "Communication hooks: hand a session's open questions to the local Overwatch page",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/hooks/scripts/audit-wrap overwatch-decision $CLAUDE_PLUGIN_ROOT/hooks/scripts/overwatch-decision.py",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
