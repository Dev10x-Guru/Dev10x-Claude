{
  "description": "Communication hooks: hand a session's open questions to the local supervisor page",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PLUGIN_ROOT/hooks/scripts/audit-wrap supervisor-decision $CLAUDE_PLUGIN_ROOT/hooks/scripts/supervisor-decision.py",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
