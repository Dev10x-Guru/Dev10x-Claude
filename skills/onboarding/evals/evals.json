{
  "skill_name": "Dev10x:onboarding",
  "eval_dimensions": [
    {
      "name": "interactive_tour",
      "description": "Guides user through capabilities with AskUserQuestion gates"
    },
    {
      "name": "config_detection",
      "description": "Detects existing configuration and skips already-done steps"
    },
    {
      "name": "completion_time",
      "description": "Guided setup completes in under 10 minutes"
    }
  ],
  "evals": [
    {
      "scenario": "First-time user with no configuration",
      "expected": "Full tour with all sections, offers git alias setup",
      "assertions": [
        {
          "check": "tool_called",
          "tool": "AskUserQuestion",
          "assertion": "experience_level_asked"
        },
        {
          "check": "tool_called",
          "tool": "AskUserQuestion",
          "assertion": "alias_setup_offered"
        },
        {
          "check": "tool_called",
          "tool": "mcp__plugin_Dev10x_cli__supervisor_review_status",
          "assertion": "review_policy_status_checked_before_ask"
        },
        {
          "check": "tool_called",
          "tool": "AskUserQuestion",
          "assertion": "review_policy_asked"
        },
        {
          "check": "tool_called",
          "tool": "mcp__plugin_Dev10x_cli__pin_supervisor_review",
          "assertion": "review_policy_persisted"
        },
        {
          "check": "tool_called",
          "tool": "AskUserQuestion",
          "assertion": "platform_registration_offered"
        },
        {
          "check": "output_contains",
          "value": "STATE-CHANGING",
          "assertion": "mutating_surface_disclosed_before_bootstrap_consent"
        }
      ]
    },
    {
      "scenario": "Returning user with aliases and playbooks configured",
      "expected": "Abbreviated tour skipping git setup and customization",
      "assertions": [
        {
          "check": "output_contains",
          "value": "Skip",
          "assertion": "configured_steps_skipped"
        }
      ]
    },
    {
      "scenario": "Returning user with supervisor_review already pinned",
      "expected": "supervisor_review_status returns pinned: true; the review-policy AskUserQuestion does NOT fire and pin_supervisor_review is NOT called",
      "assertions": [
        {
          "check": "tool_called",
          "tool": "mcp__plugin_Dev10x_cli__supervisor_review_status",
          "assertion": "review_policy_status_still_checked"
        },
        {
          "check": "behavioral",
          "value": "no-review-policy-ask",
          "assertion": "review_policy_ask_skipped_when_pinned"
        },
        {
          "check": "behavioral",
          "value": "no-pin-supervisor-review-call",
          "assertion": "pin_supervisor_review_not_called_when_pinned"
        }
      ]
    }
  ]
}
