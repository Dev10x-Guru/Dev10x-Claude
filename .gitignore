# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.coverage
# Parallel-mode coverage fragments — one per worker, left behind when a
# run is interrupted before `coverage combine` reaps them.
.coverage.*
build/
dist/

# Benchmark run artefacts (CI caches these; local runs produce them)
.benchmarks/

# Regenerable config caches (GH-1075). dev10x.config.loader derives these
# from the sibling YAML and rewrites them whenever they are missing or
# stale, so a test run or hook invocation would otherwise dirty the tree.
src/dev10x/validators/*.msgpack

# Claude Code local settings
.claude/settings.local.json
.claude/settings.local.lock
.claude/worktrees/
.claude/session/
.claude/Dev10x/
.claude-output/
